<view class="page" a:if="{{detail}}">
  <view class="card">
    <view class="title">{{detail.name}}</view>
    <view class="row">联系人：{{detail.contact}}</view>
    <view class="row">电话：{{detail.phone}}</view>
    <view class="row">地址：{{detail.address}}</view>
    <view class="row">分级：{{detail.tier}}</view>
  </view>
  <view class="card">
    <view class="title">关联事项</view>
    <view a:for="{{matters}}" a:key="id" class="row">· {{item.title}}（{{item.status}}）</view>
    <view a:if="{{matters.length === 0}}" class="row muted">暂无</view>
  </view>
</view>
