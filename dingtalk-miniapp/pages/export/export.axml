<view class="page">
  <!-- ============ 导出 ============ -->
  <view class="card">
    <view class="title">数据导出</view>
    <view class="sub">选择要导出的数据类型，导出为 CSV / JSON 备份文件。</view>

    <view class="seg">
      <view
        a:for="{{exportTypes}}"
        a:key="key"
        class="seg-item {{kind === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        onTap="chooseExportKind"
      >{{item.name}}</view>
    </view>

    <view class="hint" a:if="{{kind === 'all'}}">全量备份包含客户 + 业务 + 事项，格式为 JSON。</view>
    <view class="hint" a:else>导出格式为 CSV（可用 Excel / WPS 打开）。</view>

    <view class="btn-primary" onTap="doExport">{{exporting ? '导出中…' : '导出并保存'}}</view>
  </view>

  <!-- ============ 导入 ============ -->
  <view class="card">
    <view class="title">数据导入</view>
    <view class="sub">把 Excel / 表格另存为 CSV 后，复制其中数据粘贴到下方导入。</view>

    <view class="seg">
      <view
        class="seg-item {{importKind === 'customers' ? 'active' : ''}}"
        data-key="customers"
        onTap="chooseImportKind"
      >客户</view>
      <view
        class="seg-item {{importKind === 'business' ? 'active' : ''}}"
        data-key="business"
        onTap="chooseImportKind"
      >业务台账</view>
    </view>

    <view class="tpl-link" onTap="copyTemplate">复制 CSV 表头模板</view>

    <textarea
      class="import-area"
      placeholder="在此粘贴 CSV 内容（含表头第一行）"
      value="{{importText}}"
      onInput="onImportText"
    />

    <view class="btn-primary" onTap="doImport">{{importing ? '导入中…' : '开始导入'}}</view>

    <view class="result" a:if="{{importResult}}">{{importResult}}</view>

    <view class="detail-box" a:if="{{importDetails.length > 0}}">
      <view class="detail-head">
        <text>剔除明细（{{importDetails.length}}条{{importDetailsMore > 0 ? '，另有'+importDetailsMore+'条未显示' : ''}}）</text>
        <text class="detail-copy" onTap="copySkippedDetails">复制</text>
      </view>
      <view class="detail-item" a:for="{{importDetails}}" a:key="line">
        <text class="detail-line">第{{item.line}}行</text>
        <text class="detail-key">{{item.key}}</text>
        <text class="detail-reason">{{item.reason}}</text>
      </view>
    </view>
  </view>
</view>
