.page { padding: 16rpx; }
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.title { font-size: 32rpx; font-weight: 600; }
.sub { color: #888; font-size: 24rpx; margin: 12rpx 0 24rpx; line-height: 1.5; }

.seg {
  display: flex;
  gap: 12rpx;
  background: #f0f2f5;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 16rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #555;
  border-radius: 8rpx;
}
.seg-item.active {
  background: #1677ff;
  color: #fff;
  font-weight: 600;
}

.hint { color: #999; font-size: 22rpx; margin-bottom: 20rpx; }

.btn-primary {
  background: #1677ff;
  color: #fff;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-top: 8rpx;
}
.btn-primary:active { opacity: 0.85; }

.tpl-link {
  color: #1677ff;
  font-size: 24rpx;
  margin-bottom: 16rpx;
  text-decoration: underline;
}

.import-area {
  width: 100%;
  min-height: 200rpx;
  background: #f7f8fa;
  border: 1rpx solid #e5e6eb;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 24rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.result {
  margin-top: 16rpx;
  color: #1677ff;
  font-size: 26rpx;
  text-align: center;
}

.detail-box {
  margin-top: 20rpx;
  background: #fff7f0;
  border: 1rpx solid #ffd8a8;
  border-radius: 12rpx;
  padding: 16rpx;
}
.detail-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #d9480f;
  margin-bottom: 12rpx;
}
.detail-copy {
  color: #1677ff;
  text-decoration: underline;
}
.detail-item {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  font-size: 22rpx;
  color: #666;
  padding: 8rpx 0;
  border-top: 1rpx solid #ffe8cc;
}
.detail-line { color: #adb5bd; }
.detail-key { color: #d9480f; font-weight: 600; }
.detail-reason { color: #868e96; flex-basis: 100%; }
