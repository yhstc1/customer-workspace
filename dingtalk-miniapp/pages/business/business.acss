.action-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.action-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #f0f2f5;
  color: #1677ff;
  border-radius: 12rpx;
  font-size: 26rpx;
}
.action-btn:active { opacity: 0.7; }
.title { font-size: 30rpx; font-weight: 600; }
.sub { color: #888; font-size: 24rpx; margin-top: 8rpx; }
.meta { color: #999; font-size: 22rpx; margin-top: 8rpx; }
.placeholder { text-align: center; color: #999; padding: 80rpx 0; font-size: 26rpx; }
