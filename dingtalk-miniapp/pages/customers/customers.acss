.search { padding: 16rpx; background: #fff; position: sticky; top: 0; }
.search input { background: #f0f0f0; border-radius: 12rpx; padding: 16rpx; }
.action-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.action-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #f0f2f5;
  color: #1677ff;
  border-radius: 12rpx;
  font-size: 26rpx;
}
.action-btn:active { opacity: 0.7; }
.title { font-size: 32rpx; font-weight: 600; }
.sub { color: #888; font-size: 24rpx; margin-top: 8rpx; }
.tag { display: inline-block; margin-top: 12rpx; padding: 4rpx 12rpx; background: #e6f0ff; color: #1677ff; border-radius: 8rpx; font-size: 22rpx; }
