page {
  background: #f5f5f5;
  font-size: 28rpx;
  color: #333;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.btn-primary {
  background: #1677ff;
  color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}
.placeholder {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}
