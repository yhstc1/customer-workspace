# ============ 客户管理平台 —— 环境变量示例 ============
# 使用：复制本文件为 .env（.env 已被 .gitignore 忽略，不会进仓库）。
# 线上 FC 的密钥统一存在 FC 函数「环境变量」里，部署脚本(fc_restore_env_sdk.py)
# 会把本地 .env 推到 FC；代码运行时只从 os.environ 读取，不依赖文件系统 .env。
#
# 本系统采用「手机号自助注册」登录，无需任何第三方凭证。
# 管理员初始账号：手机号 18607184641 / 密码 123456
# 其他成员在登录页用手机号自助注册，默认密码 123456。
#
# ---- 线上 FC 必填（由 fc_restore_env_sdk.py 推送到 FC 环境变量）----
# DING_APP_KEY=          # 钉钉 H5 免登 AppKey
# DING_APP_SECRET=       # 钉钉 H5 免登 AppSecret
# JWT_SECRET=            # 登录态签名密钥（请改成随机长串）
# MYSQL_HOST=            # RDS 地址
# MYSQL_PORT=3306
# MYSQL_USER=crm_user
# MYSQL_PASSWORD=        # RDS 密码
# MYSQL_DB=crm
# TENCENT_MAP_KEY=       # 腾讯地图 WebService Key（地址->经纬度）
#
# ---- 本地开发可选（仅在非 FC 环境、未设 MYSQL_HOST 时由 app.py 加载）----
# TENCENT_MAP_KEY=你的Key
#
# ---- 钉钉群机器人推送（本地开发可选）----
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxxx
# DINGTALK_SECRET=你的SEC密钥
#
# ---- 阿里云 AccessKey（部署脚本用，禁止写进 .py/.md 提交）----
# 在本机 shell 导出，或填入 .env（.env 已被 gitignore）：
# ALIYUN_AK_ID=你的阿里云AccessKeyId
# ALIYUN_AK_SECRET=你的阿里云AccessKeySecret
# ALIYUN_REGION=cn-hangzhou
# ALIYUN_ACCOUNT_ID=你的阿里云账号ID
# ALIYUN_FC_FUNCTION=crm-api-fc
